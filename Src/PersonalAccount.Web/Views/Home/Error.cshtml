@model ErrorViewModel

<div class="container mt-5">
   <h1 class="text-danger">Ошибка!</h1>

    <div class="card">
        <div class="card-header bg-light">
            @Model.Title
        </div>
        <div class="card-body">
            <p class="card-text">@Model.ErrorText</p>
        </div>
        @if (!string.IsNullOrEmpty(Model.StackTrace))
        {
            <div class="card-footer bg-transparent border-top-0">
                <details>
                    <summary>Стек вызова (Stack Trace)</summary>
                    <pre class="text-muted small">@Model.StackTrace</pre>
                </details>
            </div>
        }
    </div>
</div>
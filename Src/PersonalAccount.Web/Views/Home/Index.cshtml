@model BranchSettingsModel

<div class="container mt-3">
    <h3 class="mb-3">Настройки загрузки данных</h3>

    @if (!string.IsNullOrEmpty(Model.ErrorText))
    {
        <div class="alert alert-danger" role="alert">
            <strong>Ошибка валидации:</strong> @Model.ErrorText
        </div>
    }
    @if (!string.IsNullOrEmpty(Model.SuccessText))
    {
        <div class="alert alert-success" role="alert">@Model.SuccessText</div>
    }

    <form method="get" asp-action="Index" class="mb-4">
        <div class="form-group">
            <label class="form-label">Филиал:</label>
            <select name="branchId" class="form-select" onchange="this.form.submit()">
                <option value="">-- Выберите филиал --</option>
                @foreach (var b in Model.Branches)
                {
                    if (Model.Branch != null && b.Id == Model.Branch.Id)
                    {
                        <option value="@b.Id" selected>@b.Name</option>
                    }
                    else
                    {
                        <option value="@b.Id">@b.Name</option>
                    }
                }
            </select>
        </div>
    </form>

    @if (Model.Branch != null)
    {
        <form method="post" asp-action="SaveSettings">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Branch.Id" />

            <div class="card">
                <div class="card-header">
                    <strong>@Model.Branch.Name</strong>
                </div>
                <div class="card-body">

                    <div class="mb-3">
                        <label class="form-label">Уникальный код:</label>
                        <input type="text" class="form-control" value="@Model.Branch.Id" readonly />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Описание настройки:</label>
                        <input type="text" class="form-control" asp-for="Branch.Settings.Description"
                               maxlength="255" />
                        <div class="form-text">Не более 255 символов.</div>
                    </div>

                    <div class="row">
                        <div class="col-md-4">
                            <div class="mb-3">
                                <label class="form-label">Начальная позиция:</label>
                                <input type="number" min="0" class="form-control"
                                       asp-for="Branch.Settings.StartPosition" required />
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="mb-3">
                                <label class="form-label">Размер пачки:</label>
                                <input type="number" min="1" class="form-control"
                                       asp-for="Branch.Settings.BatchSize" required />
                            </div>
                        </div>
                    </div>

                </div>
                <div class="card-footer text-end">
                    <button type="submit" class="btn btn-primary">Сохранить</button>
                    <a class="btn btn-secondary"
                       asp-action="Index"
                       asp-route-branchId="@Model.Branch.Id">Сбросить</a>
                </div>
            </div>
        </form>
    }
</div>
